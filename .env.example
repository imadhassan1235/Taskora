# ================================================
# Taskora — Local Environment Configuration
# ================================================
# Copy this to .env.local and fill in your values.
# DO NOT commit .env.local to version control.
# ================================================

# Your Google AI Studio API key
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Google AI model to use (check availability in your account)
# gemini-3.5-flash-lite supports text and image input for chat and extraction.
GEMMA_MODEL=gemini-3.5-flash-lite
